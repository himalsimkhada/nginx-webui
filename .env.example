# Shared across all webui-family services (webui facade + this backend) —
# must be THE SAME for auto-login between webui and nginx-webui.
WEBUI_PASSWORD=password
# Unique per service; used to sign session cookies.
SECRET_KEY=change-me-a-long-random-string

# This backend
NGINX_WEBUI_PORT=8400
NGINX_CONF_DIR=/etc/nginx
SERVICE_NAME=nginx-webui
# For containers only — a mounted host log path to tail.
LOG_FILE=